<li>((3. tokip paṭalam)) <A HREF="#_patalam_4">[44-51]</A>
<li>((6. tattitap paṭalam)) <A HREF="#_patalam_5">[52-59]</A>
<li>((5. tātup paṭalam)) <A HREF="#_patalam_6">[60-70]</A>
<li>((6. kiriyā patap paṭalam)) <A HREF="#_patalam_7">[71-85]</A>
</UL>

<LI>((mūṉṟāvatu poruḷatikāram))
<UL>
